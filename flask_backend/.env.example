# ─── Flask Core ───────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret

# ─── Database ─────────────────────────────────────────────────
# PostgreSQL (production / default)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/influencer_db

# SQLite fallback — used automatically if DATABASE_URL is not set
# DATABASE_URL=sqlite:///influencer_dev.db

# ─── File Uploads ─────────────────────────────────────────────
UPLOAD_FOLDER=uploads/influencer_photos
MAX_CONTENT_LENGTH=10485760

# ─── Admin seed credentials ───────────────────────────────────
ADMIN_EMAIL=admin@cofluence.dev
ADMIN_PASSWORD=Cofluence@2025

# ─── App port ─────────────────────────────────────────────────
PORT=5000

# ─── Email (Flask-Mail via Gmail SMTP) ────────────────────────────────────────
# Generate a Gmail App Password at https://myaccount.google.com/apppasswords
# (Requires 2FA enabled on the Gmail account)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_DEFAULT_SENDER=noreply@cofluence.dev

# ─── Frontend URL (used in email links) ───────────────────────────────────────
# Development: http://localhost:5173
# Production:  https://your-vercel-app.vercel.app
FRONTEND_URL=http://localhost:5173
